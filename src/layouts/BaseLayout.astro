---
import "../styles/global.css";
import Header from "@/components/sections/Header.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/sections/Footer.astro";
import { type SEOProps, SEO } from "astro-seo";
import { ClientRouter } from "astro:transitions";

type Props = SEOProps;

const {
  title,
  description = "Faisal's blog, where he writes about programming, movies, and anything else that interests him.",
  openGraph,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(
  openGraph?.basic?.image ? openGraph.basic.image : "/opengraph-image.jpg",
  Astro.url.origin,
);
---

<!doctype html>
<html lang="en" transition:name="root" transition:animate="none">
  <head>
    <ClientRouter />
    <script is:inline>
      const setTheme = () => {
        const theme = localStorage.getItem("theme") || "system";
        const isDark =
          theme === "dark" ||
          (theme === "system" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);

        document.documentElement.classList.toggle("dark", isDark);
        document.documentElement.setAttribute("data-active-theme", theme);
      };

      // Run on initial load
      setTheme();

      // Run every time Astro swaps the page content
      document.addEventListener("astro:after-swap", setTheme);
    </script>
    <SEO
      title={title}
      titleTemplate="%s • Faisal M."
      titleDefault="Faisal M."
      description={description}
      openGraph={{
        basic: {
          title: title ? title : "Faisal M.",
          type: openGraph?.basic.type ? openGraph.basic.type : "website",
          image: ogImageURL.href,
          url: canonicalURL,
        },
        optional: {
          description: description,
          locale: "id_ID",
          siteName: "Faisal M.",
        },
        image: {
          type: "image/jpeg",
          alt: openGraph?.image?.alt
            ? openGraph.basic.image
            : "Faisal M's Blog.",
        },
      }}
      twitter={{
        card: "summary_large_image",
        site: "@hrrblealtruist",
        creator: "@hrrblealtruist",
        title: title ? title : "Faisal M.",
        image: ogImageURL.href,
        imageAlt: openGraph?.image?.alt
          ? openGraph.basic.image
          : "Faisal M's Blog.",
        description: description,
      }}
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <div class="relative min-h-screen w-full">
      <div
        class="relative z-10 container mx-auto flex min-h-screen max-w-[60ch] flex-col gap-12 px-6 py-12 sm:py-24"
      >
        <Header />
        <main class="flex flex-col space-y-12">
          <slot />
        </main>
        <Navbar pathname={Astro.url.pathname} transition:persist />
        <Footer />
      </div>
    </div>
  </body>
</html>
