---
import "../styles/global.css";
import { type SEOProps, SEO } from "astro-seo";
import { getImage } from "astro:assets";
import ogImage from "../../public/opengraph-image.jpg";

type Props = SEOProps;

const {
  title,
  description = "Faisal's blog, where he writes about programming, movies, and anything else that interests him.",
  openGraph,
} = Astro.props;

const defaultOgImage = await getImage({
  src: ogImage,
  format: "jpeg",
});

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(
  openGraph?.basic?.image ? openGraph.basic.image : defaultOgImage.src,
  Astro.url.origin,
);
---

<!doctype html>
<html lang="en">
  <head>
    {
      import.meta.env.PROD && (
        <script
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id="77334038-94b4-4c62-8b82-45a85059dd82"
        />
      )
    }
    <script is:inline>
      const setTheme = () => {
        const theme = localStorage.getItem("theme") || "system";
        const isDark =
          theme === "dark" ||
          (theme === "system" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);

        document.documentElement.classList.toggle("dark", isDark);
        document.documentElement.setAttribute("data-active-theme", theme);
      };

      // 1. Initial run
      setTheme();

      // 2. Listen for manual system preference changes (e.g., sunset/sunrise or OS toggle)
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", (e) => {
          // ONLY update if the user has selected "system" mode
          if (
            localStorage.getItem("theme") === "system" ||
            !localStorage.getItem("theme")
          ) {
            document.documentElement.classList.toggle("dark", e.matches);
          }
        });

      // 3. Keep your Astro swap listener
      document.addEventListener("astro:after-swap", setTheme);
    </script>
    <SEO
      title={title}
      titleTemplate="%s • Faisal M."
      titleDefault="Faisal M."
      description={description}
      openGraph={{
        basic: {
          title: title ? title : "Faisal M.",
          type: openGraph?.basic.type ? openGraph.basic.type : "website",
          image: ogImageURL.href,
          url: canonicalURL,
        },
        optional: {
          description: description,
          locale: "id_ID",
          siteName: "Faisal M.",
        },
        image: {
          type: "image/jpeg",
          alt: openGraph?.image?.alt ? openGraph.image.alt : "Faisal M's Blog.",
        },
        article: openGraph?.article ?? {},
      }}
      twitter={{
        card: "summary_large_image",
        site: "@hrrblealtruist",
        creator: "@hrrblealtruist",
        title: title ? title : "Faisal M.",
        image: ogImageURL.href,
        imageAlt: openGraph?.image?.alt
          ? openGraph.image.alt
          : "Faisal M's Blog.",
        description: description,
      }}
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta name="generator" content={Astro.generator} />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <slot />
  </body>
</html>
