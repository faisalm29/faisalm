---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { formatDate } from "@/lib/utils";
import { Icon } from "astro-icon/components";
import { MDXComponents } from "@/components/mdx/MDXComponets";
import { getImage } from "astro:assets";

export const getStaticPaths = async () => {
  const generalPosts = await getCollection("generalPost");
  return generalPosts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);

let ogImageURL: string;
if (post.data.thumbnail) {
  const thumbnail = await getImage({
    src: post.data.thumbnail,
    format: "jpeg",
  });
  ogImageURL = new URL(thumbnail.src, Astro.url.origin).href;
} else {
  ogImageURL = new URL("/opengraph-image.jpg", Astro.url.origin).href;
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  openGraph={{
    basic: {
      image: ogImageURL,
      title: post.data.title,
      type: "article",
    },
    image: {
      alt: `${post.data.title} post's thumbnail'`,
    },
    article: {
      publishedTime: new Date(post.data.publishedAt).toISOString(),
      authors: ["Faisal M."],
      section: "General Writings",
      tags: ["general"],
    },
  }}
>
  <article class="flex flex-col space-y-6">
    <div class="flex flex-col space-y-8">
      {
        post.data.thumbnail && (
          <div class="relative aspect-2/1 w-full overflow-hidden rounded-md">
            <Image
              src={post.data.thumbnail}
              alt={post.data.title}
              layout="constrained"
              format="webp"
              class="h-full w-full object-cover object-center"
            />
          </div>
        )
      }
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2">
          <Icon name="calendar" size={16} class="text-muted-foreground" />
          <time
            datetime={post.data.publishedAt}
            class="text-muted-foreground text-sm"
          >
            {formatDate(post.data.publishedAt)}
          </time>
        </div>
        <div class="flex items-center gap-2">
          <Icon name="timer" size={16} class="text-muted-foreground" />
          <p class="text-muted-foreground text-sm">
            {remarkPluginFrontmatter.readingTime}
          </p>
        </div>
      </div>
      <h1 class="text-2xl font-semibold">{post.data.title}</h1>
    </div>
    <div
      class="prose text-muted-foreground dark:prose-invert max-w-full leading-relaxed text-pretty"
    >
      <Content components={MDXComponents} />
    </div>
  </article>
</BaseLayout>
