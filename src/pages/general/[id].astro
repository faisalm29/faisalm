---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { formatDate } from "@/lib/utils";
import { Icon } from "astro-icon/components";
import { MDXComponents } from "@/components/mdx/MDXComponets";

export const getStaticPaths = async () => {
  const generalPosts = await getCollection("generalPost");
  return generalPosts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout>
  <article class="flex flex-col space-y-6">
    <div class="flex flex-col space-y-8">
      {
        post.data.thumbnail && (
          <div class="relative aspect-2/1 w-full overflow-hidden rounded-md">
            <Image
              src={post.data.thumbnail}
              alt={post.data.title}
              layout="constrained"
              format="webp"
            />
          </div>
        )
      }
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2">
          <Icon name="calendar" size={16} class="text-muted-foreground" />
          <time
            datetime={post.data.publishedAt}
            class="text-muted-foreground text-sm"
          >
            {formatDate(post.data.publishedAt)}
          </time>
        </div>
        <div class="flex items-center gap-2">
          <Icon name="timer" size={16} class="text-muted-foreground" />
          <!-- <p class="text-muted-foreground text-sm">{post.readTime}</p> -->
        </div>
      </div>
      <h1 class="text-2xl font-semibold">{post.data.title}</h1>
    </div>
    <div
      class="prose text-muted-foreground dark:prose-invert max-w-full leading-relaxed text-pretty"
    >
      <Content components={MDXComponents} />
    </div>
  </article>
</BaseLayout>
