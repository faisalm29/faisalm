---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageContainer } from "@/components/containers";
import { GeneralPosts } from "@/components/sections";
import { getCollection } from "astro:content";
import { sortPosts } from "@/lib/utils";

const sortedGeneralPosts = sortPosts(await getCollection("generalPost")).slice(
  0,
  5,
);
console.log(sortedGeneralPosts[0]);
---

<BaseLayout>
  <PageContainer>
    <h1>General</h1>
    <GeneralPosts generalPosts={sortedGeneralPosts} />
  </PageContainer>
</BaseLayout>
