---
import PageContainer from "@/components/containers/PageContainer.astro";
import GeneralPostsSection from "@/components/sections/GeneralPostsSection.astro";
import { getCollection } from "astro:content";
import { sortPosts } from "@/lib/utils";

const sortedGeneralPosts = sortPosts(await getCollection("generalPost"));
---

<PageContainer>
  <GeneralPostsSection generalPosts={sortedGeneralPosts} />
</PageContainer>
