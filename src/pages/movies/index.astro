---
import PageContainer from "@/components/containers/PageContainer.astro";
import MovieReviewsSection from "@/components/sections/MovieReviewsSection.astro";
import { getCollection } from "astro:content";
import { getMovies } from "@/lib/tmdb";
import { sortMovies } from "@/lib/utils";

const movieIds = (await getCollection("movieReviewPost")).map(
  (movie) => movie.data.tmdbId,
);
const movies = sortMovies(await getMovies(movieIds));
---

<PageContainer>
  <MovieReviewsSection movies={movies} />
</PageContainer>
