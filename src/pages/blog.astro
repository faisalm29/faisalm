---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import GeneralPostsSection from "@/components/sections/GeneralPostsSection.astro";
import ProgrammingPostsSection from "@/components/sections/ProgrammingPostsSection.astro";
import MovieReviewsSection from "@/components/sections/MovieReviewsSection.astro";
import { sortPosts, sortMovies } from "@/lib/utils";
import { getMovies } from "@/lib/tmdb";

const sortedGeneralPosts = sortPosts(await getCollection("generalPost")).slice(
  0,
  5,
);
const sortedProgrammingPosts = sortPosts(
  await getCollection("programmingPost"),
).slice(0, 5);
const movieTmdbIds = (await getCollection("movieReviewPost")).map(
  (movie) => movie.data.tmdbId,
);
const movies = sortMovies(await getMovies(movieTmdbIds)).slice(0, 5);
---

<BaseLayout title="Blog" description="All of my writings.">
  <h1 class="text-2xl font-medium">Blog</h1>
  <GeneralPostsSection
    as="h2"
    generalPosts={sortedGeneralPosts}
    viewMoreButton
  />
  <ProgrammingPostsSection
    as="h2"
    programmingPosts={sortedProgrammingPosts}
    viewMoreButton
  />
  <MovieReviewsSection as="h2" movies={movies} viewMoreButton />
</BaseLayout>
