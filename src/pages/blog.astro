---
import { getCollection } from "astro:content";
import { PageContainer } from "@/components/containers";
import {
  GeneralPosts,
  ProgrammingPosts,
  MovieReviews,
} from "@/components/sections";
import { sortPosts, sortMovies } from "@/lib/utils";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMovies } from "@/lib/tmdb";

const sortedGeneralPosts = sortPosts(await getCollection("generalPost")).slice(
  0,
  5,
);
const sortedProgrammingPosts = sortPosts(
  await getCollection("programmingPost"),
).slice(0, 5);
const movieIds = (await getCollection("movieReviewPost")).map(
  (movie) => movie.data.tmdbId,
);
const movies = sortMovies(await getMovies(movieIds)).slice(0, 5);
---

<BaseLayout>
  <PageContainer>
    <h1>Blog</h1>
    <GeneralPosts generalPosts={sortedGeneralPosts} viewMorebutton />
    <ProgrammingPosts
      programmingPosts={sortedProgrammingPosts}
      viewMoreButton
    />
    <MovieReviews movies={movies} viewMoreButton />
  </PageContainer>
</BaseLayout>
