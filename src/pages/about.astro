---
import { getTopTracks } from "@/lib/spotify";
import ProfileSection from "@/components/sections/ProfileSection.astro";
import ContactsSection from "@/components/sections/ContactsSection.astro";
import TopTracksSection from "@/components/sections/TopTracksSection.astro";
import BlogStacksSection from "@/components/sections/BlogStacksSection.astro";
import PageContainer from "@/components/containers/PageContainer.astro";

const topTracks = await getTopTracks();
---

<PageContainer>
  <div class="flex flex-col space-y-2">
    <h1 class="text-2xl font-medium">About</h1>
    <p class="text-muted-foreground">
      About me, this blog, and anything related.
    </p>
  </div>
  <ProfileSection />
  <ContactsSection />
  <TopTracksSection topTracks={topTracks} />
  <BlogStacksSection />
</PageContainer>
