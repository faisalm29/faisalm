---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SummarySection from "@/components/sections/SummarySection.astro";
import LatestPostsSection from "@/components/sections/LatestPostsSection.astro";
import { sortLatestPosts } from "@/lib/utils";
import { getLatestPosts } from "@/lib/utils";

const latestPosts = await getLatestPosts();
const sortedLatestPosts = sortLatestPosts(latestPosts).slice(0, 10);
---

<BaseLayout>
  <SummarySection />
  <LatestPostsSection latesPost={sortedLatestPosts} viewMoreButton />
</BaseLayout>
