---
import { Image } from "astro:assets";
import type { TopTrack } from "@/lib/spotify.types";
import { convertMsToMinutes } from "@/lib/utils";

interface Props {
  track: TopTrack;
  number: number;
}

const { track, number } = Astro.props;
const { name, url, album, artists, duration } = track;
const albumCover = album.images.at(-1);
---

<a
  href={url}
  target="_blank"
  class="border-border hover:bg-accent/50 flex items-start justify-between gap-7 rounded-md border px-3 py-2.5 duration-300 ease-in-out"
>
  <div class="relative">
    <span class="text-muted-foreground absolute top-1 text-sm">
      {number + 1}.
    </span>
  </div>
  <div class="flex w-full items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <div
        class="size-10 shrink-0 items-center justify-center overflow-hidden rounded-sm"
      >
        {
          albumCover ? (
            <Image
              src={albumCover.url}
              alt={`${name} album's cover`}
              width={albumCover.width}
              height={albumCover.height}
              class="size-full object-cover"
            />
          ) : (
            <div class="bg-muted-foreground size-full" />
          )
        }
      </div>
      <div class="flex min-w-0 flex-col gap-1 text-balance">
        <p class="line-clamp-1">{name}</p>
        <p class="text-muted-foreground line-clamp-1 text-sm">
          {artists.map((artist) => artist.name).join(", ")}
        </p>
      </div>
    </div>
    <p class="text-muted-foreground text-sm">
      {convertMsToMinutes(duration)}
    </p>
  </div>
</a>
