---
import SectionContainer from "@/components/containers/SectionContainer.astro";
import TopTrackItem from "@/components/TopTrackItem.astro";
import type { TopTrack } from "@/lib/spotify.types";
import { getCurrentDateTime } from "@/lib/utils";

interface Props {
  topTracks: TopTrack[];
}

const { topTracks } = Astro.props;
---

<SectionContainer class="space-y-3">
  <div class="flex flex-col space-y-2">
    <h2 class="text-xl font-medium">Top Tracks</h2>
    <p class="text-muted-foreground">
      My current Spotify heavy rotation. Updated daily.
    </p>
  </div>
  <ol class="flex flex-col space-y-2">
    {
      topTracks.map((track, number) => (
        <li>
          <TopTrackItem number={number} track={track} />
        </li>
      ))
    }
  </ol>
  <small class="text-muted-foreground">
    Last updated:{" "}
    <time datetime={getCurrentDateTime().toISOString().split("T")[0]}>
      {
        getCurrentDateTime().toLocaleString("en-US", {
          timeZone: "Asia/Jakarta",
          dateStyle: "medium",
          timeStyle: "short",
          hour12: false,
        })
      }
    </time>
  </small>
</SectionContainer>
