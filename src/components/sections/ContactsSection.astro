---
import SectionContainer from "../containers/SectionContainer.astro";
import ContactItem from "@/components/ContactItem.astro";
import { Icon } from "astro-icon/components";

const contacts = [
  {
    name: "Email",
    url: "mailto:author@mfaisal.xyz",
    icon: "mail",
  },
  {
    name: "GitHub",
    url: "https://github.com/faisalm29",
    icon: "github",
  },
];
---

<SectionContainer>
  <h2 class="text-xl font-medium">Connect with Me</h2>
  <ul class="flex items-center justify-between gap-2">
    {
      contacts.map((contact) => {
        return (
          <li class="w-full">
            <ContactItem href={contact.url}>
              {contact.name}{" "}
              <Icon
                name={contact.icon}
                size={24}
                class="text-muted-foreground group-hover:text-foreground transition-all duration-300 ease-in-out"
              />
            </ContactItem>
          </li>
        );
      })
    }
  </ul>
</SectionContainer>
