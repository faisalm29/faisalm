---
import CustomLink from "@/components/CustomLink.astro";
import { Icon } from "astro-icon/components";

const credtis = [
  {
    name: "Anish Gupta",
    web: "https://anishfn.space",
  },
  {
    name: "I Putu Saputrayana",
    web: "https://iyansr.id",
  },
  {
    name: "Dillion Verma",
    web: "https://portfolio-magicui.vercel.app",
  },
];
---

<footer class="mb-12">
  <div class="flex items-end justify-between">
    <div class="flex flex-col space-y-4">
      <p class="text-foreground/30 text-sm">Credits for design inspiration</p>
      <ul class="md:flex md:gap-3">
        {
          credtis.map((credit) => (
            <li>
              <CustomLink variant="muted" href={credit.web} class="text-xs">
                <span class="flex items-center gap-px transition-all duration-300 ease-in-out hover:gap-1">
                  {credit.name}{" "}
                  <Icon
                    size={16}
                    name="arrow-up-right"
                    class="fill-muted-foreground group-hover:fill-foreground transition-all duration-300 ease-in-out"
                  />
                </span>
              </CustomLink>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="text-foreground/30 text-xl">₍^◞ ˕ ◟^₎⟆</p>
  </div>
</footer>
