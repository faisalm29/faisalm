---
import { cn } from "@/lib/utils";
import { Icon } from "astro-icon/components";

interface Props {
  fallback?: string;
  class?: string;
}

const { fallback = "/", class: className } = Astro.props;
---

<button
  id="back-button"
  data-fallback={fallback}
  class={cn(
    "inline-flex items-center justify-center gap-2 hover:gap-2.5 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4 shrink-0 [&_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive",
    className,
  )}
>
  <Icon name="arrow-left" />
  <span id="button-text"></span>
</button>

<script>
  const initBackButton = (): void => {
    const backButton = document.getElementById(
      "back-button",
    ) as HTMLButtonElement | null;
    const buttonText = document.getElementById(
      "button-text",
    ) as HTMLSpanElement | null;

    if (!backButton || !buttonText) return;

    const fallbackUrl: string = backButton.dataset.fallback || "/";

    const getHasHistory = (): boolean => {
      return (
        document.referrer !== "" &&
        document.referrer.includes(window.location.host)
      );
    };

    const updateButtonText = (): void => {
      if (getHasHistory()) {
        buttonText.textContent = "Go Back";
      } else {
        buttonText.textContent =
          fallbackUrl === "/" ? "Back to Home" : "Go Back";
      }
    };

    const handleBackNavigation = (): void => {
      if (getHasHistory()) {
        window.history.back();
      } else {
        window.location.href = fallbackUrl;
      }
    };

    updateButtonText();

    backButton.removeEventListener("click", handleBackNavigation);
    backButton.addEventListener("click", handleBackNavigation);
  };

  initBackButton();

  document.addEventListener("astro:after-swap", initBackButton);
</script>
