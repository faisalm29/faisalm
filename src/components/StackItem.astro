---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

interface Props extends HTMLAttributes<"a"> {
  href: string;
}

const { href, class: className, ...props } = Astro.props;

if (!Astro.slots.has("default")) {
  throw new Error(
    "StackItem component requires content (children) inside the slot.",
  );
}
---

<a
  {...props}
  href={href}
  target="_blank"
  class={cn(
    "hover:bg-accent/50 focus-visible:border-ring focus-visible:ring-ring/50 border-border flex rounded-md border px-1.5 py-1 text-sm transition-colors duration-300 ease-in-out outline-none focus-visible:ring-[3px]",
    className,
  )}
>
  <slot />
</a>
